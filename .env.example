# Google AI Studio / Gemini API key (used for transcription + highlight
# selection). Get one at https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Which Gemini model to use for video understanding + transcription.
# gemini-2.0-flash is fast and cheap and handles audio/video well.
GEMINI_MODEL=gemini-2.0-flash

# Max number of clips to generate per source video by default.
DEFAULT_CLIP_COUNT=6

# How many render jobs run at the same time. Keep this at 1 on small
# VPS boxes - ffmpeg + face detection are CPU heavy.
QUEUE_CONCURRENCY=1

# Absolute or relative path where uploads/work files/rendered clips are
# stored. Mount this as a volume in Docker/Coolify so clips survive
# container restarts.
STORAGE_DIR=./storage
