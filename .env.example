# Google AI Studio / Gemini API key (used for transcription + highlight
# selection). Get one at https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Which Gemini model to use for transcription + picking the clips.
# gemini-3.5-flash is fast, cheap and handles audio well. Any newer Flash
# model works too (e.g. gemini-3.6-flash) - Google retires old models, so if
# jobs fail with "hittar inte modellen", pick a current one here.
GEMINI_MODEL=gemini-3.5-flash

# Max number of clips to generate per source video by default.
DEFAULT_CLIP_COUNT=6

# Exact word timing for the captions: Whisper listens to each finished clip
# so every word lights up when it's actually said, and clips start and end
# on real word boundaries. Set to off to use the rougher estimate instead
# (splits Gemini's sentence times evenly across the words).
WORD_TIMING=on

# Whisper model for the word timing: tiny, base, small, medium or large-v3.
# small is a good balance (downloads ~480 MB once, needs ~1 GB RAM while it
# runs). Use base on a small server with 2 GB RAM or less.
WHISPER_MODEL=small

# How many days a source video is kept after its job (counted from the last
# edit), so the clips can be opened in the editor and rendered again. Old
# sources are deleted automatically. 0 = delete right after the job, which
# turns the editor off. Uploads can be big: pick what your disk can hold.
SOURCE_RETENTION_DAYS=7

# YouTube often refuses downloads from servers ("Sign in to confirm you're
# not a bot"). Save a cookies.txt from a signed-in browser on the app's
# settings page, or point this at your own file instead (then the page
# can't change it). Leave empty to use the settings page.
YTDLP_COOKIES=

# How many render jobs run at the same time. Keep this at 1 on small
# VPS boxes - ffmpeg + face detection are CPU heavy.
QUEUE_CONCURRENCY=1

# Absolute or relative path where uploads/work files/rendered clips are
# stored. Mount this as a volume in Docker/Coolify so clips survive
# container restarts.
STORAGE_DIR=./storage
